{
  "expo": {
    "name": "JourneyQuest",
    "slug": "journeyquest",
    "scheme": "journeyquest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.journeyquest.app"
    },
    "android": {
      "package": "com.journeyquest.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "걷는 동안 이동 경로와 거리를 기록하기 위해 위치를 사용합니다.",
          "locationAlwaysAndWhenInUsePermission": "화면이 꺼져 있어도 걷기 기록을 이어가기 위해 위치를 사용합니다.",
          "locationAlwaysPermission": "화면이 꺼져 있어도 걷기 기록을 이어가기 위해 위치를 사용합니다.",
          "locationFullAccuracyPermission": "걷기 거리를 정확하게 측정하려면 정확한 위치가 필요합니다.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "걷는 동안 걸음 수를 측정하기 위해 동작 데이터를 사용합니다."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ee172115-3fe7-4ec6-87ce-a4c68a6cbe7d"
      }
    }
  }
}
