# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git에 커밋되지 않습니다)

# Mapbox 계정의 Default Public Token (pk. 로 시작)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_public_token_here

# (필요한 경우에만) 네이티브 SDK 다운로드용 Secret Token (sk. 로 시작, DOWNLOADS:READ scope)
# prebuild/빌드 시 셸 환경변수로 설정: RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.xxx
